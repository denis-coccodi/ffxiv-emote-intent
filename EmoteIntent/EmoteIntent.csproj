<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.2.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Manifest fields (DalamudPackager). The assembly name, EmoteIntent, is the plugin's
         InternalName and can never change once released. -->
    <Author>Denis Coccodi</Author>
    <Name>Emote Intent</Name>
    <Punchline>Say what you mean, and play the emote that fits.</Punchline>
    <Description>Type /feel and what you mean ("/feel so happy to see you", "/feel lmao", "/feel o7"), and Emote Intent plays the unlocked emote that fits, or lists the few that might. Early version: it understands 30 emotes so far, more with each update; any emote also plays by its name or command. Runs on your PC, no AI needed. The phrase bank was written with AI help.</Description>
    <RepoUrl>https://github.com/denis-coccodi/ffxiv-emote-intent</RepoUrl>
    <Tags>emote;emotes;chat;social;roleplay</Tags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmoteIntent.Core\EmoteIntent.Core.csproj" />
  </ItemGroup>

</Project>
