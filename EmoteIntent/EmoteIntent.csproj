<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.1.0.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Manifest fields (DalamudPackager). The assembly name, EmoteIntent, is the plugin's
         InternalName and can never change once released. -->
    <Author>Denis Coccodi</Author>
    <Name>Emote Intent</Name>
    <Punchline>Say what you mean, and play the emote that fits.</Punchline>
    <Description>Type /feel and the emote you want, and Emote Intent plays it if you have it unlocked. Early version: it matches emote names and commands for now; matching what you mean ("/feel so happy to see you") is being built.</Description>
    <RepoUrl>https://github.com/denis-coccodi/ffxiv-emote-intent</RepoUrl>
    <Tags>emote;emotes;chat;social;roleplay</Tags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmoteIntent.Core\EmoteIntent.Core.csproj" />
  </ItemGroup>

</Project>
