<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev tool: reads every emote from the installed game with Lumina (the library Dalamud uses) and writes
       EmoteIntent.Core/Data/emotes.json. Run it again after a patch that adds emotes (README: Emote data). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- A command-line tool writes to the console: the in-game ban on Console doesn't apply here. -->
  <ItemGroup>
    <AdditionalFiles Remove="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'BannedSymbols.txt'))" />
  </ItemGroup>

  <ItemGroup>
    <!-- The versions Dalamud ships (Lumina 7.7, Lumina.Excel 7.5), so the sheets read the same way. -->
    <PackageReference Include="Lumina" Version="7.7.2" />
    <PackageReference Include="Lumina.Excel" Version="7.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EmoteIntent.Core\EmoteIntent.Core.csproj" />
    <!-- The plugin's own reader of Emote rows, so the export and the plugin can't disagree. -->
    <Compile Include="..\..\EmoteIntent\EmoteRows.cs" Link="EmoteRows.cs" />
  </ItemGroup>

</Project>
