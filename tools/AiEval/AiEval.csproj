<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dev tool: runs everyday sentences (cases.txt) through the phrase bank and through a model in Ollama, and
       compares how often each picks a right emote, and how fast the model answers. DEVELOPMENT.md: AI evaluation. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- A command-line tool writes to the console and talks to a local Ollama: the in-game bans don't apply here. -->
  <ItemGroup>
    <AdditionalFiles Remove="$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', '..', 'BannedSymbols.txt'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EmoteIntent.Core\EmoteIntent.Core.csproj" />
    <None Include="cases.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
