{
  "enabledPlugins": {
    "everise@everise": true
  },
  "extraKnownMarketplaces": {
    "everise": {
      "source": {
        "source": "github",
        "repo": "denis-coccodi/everise-agents"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.ps1\"",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-csharp.ps1\"",
            "timeout": 60,
            "statusMessage": "Formatting C#..."
          }
        ]
      }
    ]
  }
}
